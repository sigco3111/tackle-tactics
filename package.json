{
    "name": "tackle-tactics",
    "version": "0.2.0",
    "private": true,
    "description": "Turn-based football tactics: a positioning game in a football kit, with a career mode. Web + Tauri desktop.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "prepare": "lefthook install",
        "predev": "sh scripts/ensure-assets.sh",
        "dev": "vite",
        "prebuild": "sh scripts/ensure-assets.sh",
        "build": "tsc && vite build",
        "test": "vitest run",
        "fix": "oxlint --fix && oxfmt",
        "assets": "sh scripts/copy-assets.sh",
        "assets:upload": "sh scripts/assets-upload.sh",
        "desktop": "tauri dev",
        "desktop:build": "sh scripts/publish-desktop.sh",
        "web:build": "sh scripts/publish-web.sh",
        "release": "sh scripts/release.sh",
        "version": "node scripts/sync-version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock"
    },
    "dependencies": {
        "@fontsource/barlow-condensed": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/noto-sans-kr": "^5.3.1",
        "@fontsource/noto-sans-symbols": "^5.3.0",
        "@fontsource/noto-sans-symbols-2": "^5.3.0",
        "@fontsource/pixelify-sans": "^5.3.0",
        "@fontsource/silkscreen": "^5.3.0",
        "@fontsource/vt323": "^5.3.0",
        "@grainular/grains": "^2.4.0",
        "@grainular/nord": "^2.4.0",
        "@tauri-apps/api": "^2.12.5",
        "@tauri-apps/plugin-opener": "^2.7.3"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.6",
        "@types/node": "^24.19.2",
        "aws4fetch": "^1.0.20",
        "lefthook": "^2.2.2",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "wrangler": "^4.168.0"
    },
    "engines": {
        "node": ">=22"
    }
}
